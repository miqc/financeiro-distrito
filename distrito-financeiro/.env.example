# API local usada pelo proxy do Vite
API_PROXY_TARGET=http://127.0.0.1:8787

# Use uma URL completa apenas quando o frontend e a API forem publicados separados
VITE_API_URL=

# Servidor
HOST=0.0.0.0
PORT=8787
NODE_ENV=development

# Banco SQLite. Em nuvem, aponte para um volume persistente.
DATABASE_PATH=./data/distrito.sqlite

# Utilizadas somente ao criar o banco pela primeira vez
ADMIN_EMAIL=admin@distrito.com
ADMIN_PASSWORD=troque-esta-senha

# Sessão e acesso externo
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
CORS_ORIGIN=
