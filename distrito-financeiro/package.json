{
  "name": "distrito-financeiro",
  "version": "1.0.0",
  "description": "Controle financeiro da Barbearia Distrito",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently --kill-others -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "db:reset-admin": "node --env-file-if-exists=.env server/reset-admin-password.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
